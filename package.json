{
  "name": "cnx-calculator",
  "version": "0.3.0",
  "description": "离线科学计算器，参照 fx-991CN X 十种模式与按键布局，支持完整键盘操作",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "plateboheng-cell",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "test:ui": "node scripts/graphical-ui-test.mjs",
    "start": "electron .",
    "pack": "npm run build && electron-builder --win --x64 --dir",
    "release:win": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "0.154.0",
    "katex": "^0.16.22",
    "mathjs": "15.2.0",
    "mathlive": "0.111.1"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "playwright": "^1.58.0",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "io.github.plateboheng-cell.cnx-calculator",
    "productName": "CNX Calculator",
    "copyright": "Copyright © 2026 plateboheng-cell · MIT",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "compression": "normal",
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build-resources/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "CNX-Calculator-${version}-Windows-x64.exe"
    }
  }
}
